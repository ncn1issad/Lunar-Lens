{
  "name": "lunar-lense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lunar-lense/web build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @lunar-lense/web build && pnpm --filter @lunar-lense/api build",
    "start": "pnpm --filter @lunar-lense/api start",
    "preview": "pnpm build && pnpm start",
    "test": "pnpm build && pnpm --filter @lunar-lense/web test && pnpm --filter @lunar-lense/api test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "deploy": "pnpm build && pnpm --filter @lunar-lense/api run deploy"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
