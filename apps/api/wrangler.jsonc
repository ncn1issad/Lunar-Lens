{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunar-lense",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
